{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoLDeathReplay",
  "version": "0.2.1",
  "identifier": "io.github.robinwibom.loldeathreplay",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Replays your League of Legends deaths in a small floating window",
    "copyright": "Copyright (C) 2026 Robin Wibom. Licensed under the GPL-3.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4MTQ3MUM5NDdEMTk5NzUKUldSMW1kRkh5WEVVT09ySE10MWZlRW55TFFEdUtLRXBaR1N5SDlOYXMrNCtVUTgvMXJENmJGQnoK",
      "endpoints": ["https://github.com/robinwibom/lol-death-replay/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
